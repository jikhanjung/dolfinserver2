# `/srv/dolfinserver2/.env` 의 본. **그대로 복사하지 말 것** — SECRET_KEY 는
# 자리마다 새로 뽑는다 (`bootstrap.sh` 가 뽑아 준다).
#
# 여기 값들은 `finweb/settings.py` 가 읽는 이름 그대로다. 컨테이너 안 경로임에
# 주의 — 호스트 경로는 compose 의 volumes 가 맡는다.

# **`build.sh` 가 여기를 함께 고친다.** 손으로 안 맞추는 이유가 있다 —
# 새 자리를 `bootstrap.sh` 로 세우면 이 값이 그대로 `.env` 가 되는데, 낡아
# 있으면 **옛 이미지로 떠 놓고 새 판인 줄 안다.** 실제로 시험 자리가 그렇게
# 떴다 (2026-08-26, `/healthz` 가 404 라서 알았다).
IMAGE_TAG=0.7.0

# **이 자리가 무슨 일을 하나.** `work` 검출·분할·밑동·검토 / `reid` 개체 분류만.
# 개체를 만들고 지느러미를 넣는 일은 **한 자리에서만** 해야 `Individual`·
# `Identification` 의 주인이 하나로 남는다 (`HANDOFF.md` 의 `## 서버를 둘로 나눈다`).
# 안 주면 `work` 다. **m710q 운영은 `work`, GCP(`dolfinid2`)는 `reid`.**
FIN_ROLE=work

# **접속 코드.** 이 앱에는 사람마다의 인증이 없다 — `login_required` 도 없고
# 쓰기 경로가 열려 있어, 주소를 아는 사람이 판정을 지울 수 있다. 코드로 문을
# 막는다. **빈 값이면 문이 없다** (m710q 의 개발·시험 자리는 그대로 둔다).
# 인증의 **대신**이지 인증이 아니다 — 누가 했는지가 안 남고, 한 사람만 뺄 수
# 없고, **TLS 없이 공개 주소로 열면 코드도 세션 쿠키도 평문으로 간다.**
FIN_ACCESS_CODE=
# **https 뒤에 있으면 1.** 쿠키를 https 에서만 보내게 하고, 동시에 Django 가
# 스스로를 https 로 알게 한다(`X-Forwarded-Proto`) — 안 켜면 CSRF 가 스킴
# 어긋남으로 막아 **코드를 맞게 넣어도 403** 이 난다.
FIN_HTTPS=0

FIN_SECRET_KEY=CHANGE-ME
FIN_DEBUG=0
# 시험 서버는 IP:8085 로 붙는다. 도메인을 붙이면 여기와 FIN_TRUSTED_ORIGINS 에
# 함께 적는다 (POST 가 CSRF 에서 막힌다).
FIN_ALLOWED_HOSTS=*
FIN_TRUSTED_ORIGINS=

# 컨테이너 안 경로 — compose 의 마운트와 짝이다.
# **운영은 사본이 아니다.** 호스트의 `/srv/dolfinserver2/db/fin.db` 가 곧
# 파이프라인이 여는 파일이다 (`settings` 의 `FIN_DB` 기본값도 그 자리다).
FIN_DB=/app/hostdb/fin.db
FIN_CROPS=/app/crops
FIN_PHOTOS=/app/photos
# **판을 빠뜨리면 격자가 조용히 빈다.** 개체 판정은 새 조각을 가리키는데
# 기본값(`reid/v1`)은 지운 판이라, 안 주면 화면이 텅 빈 채로 200 을 낸다.
FIN_REID=/app/reid/v3

GUNICORN_WORKERS=2
